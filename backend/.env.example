# Puerto del servidor
PORT=3000

# Cadena de conexión de MongoDB (local o Atlas)
MONGO_URI=mongodb://localhost:27017/airbnb

# Secreto para firmar los tokens JWT
JWT_SECRET=your_jwt_secret_key

# Credenciales de correo (Gmail + contraseña de aplicación)
EMAIL_USER=example@gmail.com
EMAIL_PASS=your_app_password
